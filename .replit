run = "streamlit run UI/frontend.py --server.address=0.0.0.0 --server.port=8501"
language = "python3"

[nix]
channel = "stable-23_11"

[deployment]
run = ["sh", "-c", "uvicorn src.app:app --host 0.0.0.0 --port 8000 & streamlit run UI/frontend.py --server.address=0.0.0.0 --server.port=8501"]

[unitTest]
language = "python3"
run = "python -m pytest"